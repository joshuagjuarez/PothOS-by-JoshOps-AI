{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "pothos": {
      "type": "streamable-http",
      "url": "https://mcp.joshops.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "openid",
              "profile",
              "email"
            ],
            "defaultScopes": [
              "openid",
              "profile",
              "email"
            ]
          }
        }
      }
    }
  }
}
